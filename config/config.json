{
    "dp_vt_config": {
        "max_jerk": 10,
        "max_v": 6,
        "dt": 0.1,
        "max_s": 60,
        "max_a": 0.5,
        "min_a": -5,
        "max_path_s": 20,
        "speed_limit_samples": 40,
        "valid_max_st_num": 0,
        "max_single_speed_limit_points": 0,
        "max_speed_limit_intervals": 1,
        "max_t": 5,
        "max_abs_slope": 20,
        "max_min_s": 10,
        "max_max_s": 30,
        "seed": 3260
    },
    "model_config": {
        "SAC_constructor": {
            "policy": "MlpPolicy",
            "verbose": 1,
            "learning_rate": 3e-4,
            "ent_coef": "auto_0.2",
            "tau": 1e-3,
            "batch_size": 256,
            "buffer_size": 2e5,
            "target_entropy": "auto",
            "tensorboard_log": ".tensorboard",
            "policy_kwargs": {
                "net_arch": {
                    "pi": [
                        256,
                        256
                    ],
                    "qf": [
                        256,
                        256
                    ]
                },
                "activation_fn": "nn.LeakyReLU",
                "optimizer_kwargs": {
                    "weight_decay": 1e-5
                }
            }
        },
        "train_param": {
            "total_timesteps": 10000000,
            "log_interval": 4
        },
        "learning_schedule": {
            "schedule": "cosine",
            "initial_lr": 3e-4,
            "final_lr": 1e-5
        }
    },
    "train_config": {
        "use_multi_env": true,
        "n_envs": 1
    }
}