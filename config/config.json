                        256
                    ],
                    "qf": [
                        256,
                        256
                    ]
                },
                "activation_fn": "nn.LeakyReLU",
                "optimizer_kwargs": {
                    "weight_decay": 1e-05
                }
            }
        },
        "train_param": {
            "total_timesteps": 1000000,
            "log_interval": 4
        },
        "learning_schedule": {
            "schedule": "cosine",
            "initial_lr": 0.0003,
            "final_lr": 1e-05
        }
    },
    "train_config": {
        "use_multi_env": false,
        "n_envs": 1
    },
    "curriculum_config": {
        "enabled": true,
        "stages": [
            {
                "name": "speed",
                "config_overrides": {
                    "dp_vt_config": {
                        "valid_max_st_num": 0,
